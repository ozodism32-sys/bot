# Telegram bot tokeni (@BotFather dan olinadi)
BOT_TOKEN=123456789:AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA

# Admin Telegram ID lari (vergul bilan), /stats buyrug'i uchun
ADMIN_IDS=123456789

# Anthropic Claude API kaliti (AI matn yozish uchun). Bo'sh qolsa AI o'chiq bo'ladi.
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5-5
# low | medium | high
AI_EFFORT=medium

# Fayllar va baza
STORAGE_DIR=storage
DB_PATH=data/bot.db

# LibreOffice buyrug'i (soffice yoki to'liq yo'l)
SOFFICE_PATH=soffice
# Bir vaqtda nechta PDF konvertatsiya ishlashi mumkin
PDF_CONCURRENCY=2
PDF_TIMEOUT=120

# Ixtiyoriy: Telegram'ga proksi orqali ulanish (http://host:port yoki socks5://user:pass@host:port)
TELEGRAM_PROXY=
# Ixtiyoriy: proksi o'z sertifikatini ishlatsa, CA fayl yo'li
# SSL_CERT_FILE=/path/to/ca.crt

LOG_LEVEL=INFO
